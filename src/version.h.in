/**
@file version.h
@brief THAMES-Hydration build identity (generated by CMake at configure time).

@warning DO NOT EDIT.  This file is generated from src/version.h.in and
overwritten every time CMake configures the build.  The template lives in
src/version.h.in; the generated file (src/version.h) is gitignored.
*/

#ifndef VERSION_H
#define VERSION_H

// Numeric back-compat macros (older code reads these).
#define VERSION       @THAMES_HYDRATION_VERSION@
#define VERSION_MAJOR @THAMES_HYDRATION_VERSION_MAJOR@
#define VERSION_MINOR @THAMES_HYDRATION_VERSION_MINOR@

// New identity macros used by RunMetadata to stamp every output.
#define THAMES_VERSION_STRING "@THAMES_HYDRATION_VERSION_STRING@"
#define THAMES_VERSION_MAJOR  @THAMES_HYDRATION_VERSION_MAJOR@
#define THAMES_VERSION_MINOR  @THAMES_HYDRATION_VERSION_MINOR@
#define THAMES_VERSION_PATCH  @THAMES_HYDRATION_VERSION_PATCH@
#define THAMES_GIT_HASH       "@THAMES_GIT_HASH@"
#define THAMES_BUILD_DATE     "@THAMES_BUILD_DATE@"

#endif
